# MediCare Healthcare Application Backend Environment Configuration

# Gemini AI API Key (required for prescription OCR & AI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Places API (New) Key (required for real GPS nearby hospital discovery)
# Ensure "Places API (New)" is enabled with billing in your Google Cloud Console.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Django Secret Key
SECRET_KEY=your_django_secret_key_here

# Database Configuration (PostgreSQL or fallback to SQLite)
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
